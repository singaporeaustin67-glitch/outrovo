# LLM provider config (OpenAI-compatible)
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=qwen/qwen3.8-27b
LLM_FALLBACK_MODELS=qwen/qwen3.6-27b,openai/gpt-oss-20b,openai/gpt-oss-120b

# Optional: raises GitHub API rate limits
GITHUB_TOKEN=

# Optional: enables OpenCorporates (local business founders/officers from public registries)
# Free API key with registration at https://opencorporates.com/api_requests/new
OPENCORPORATES_TOKEN=

# Optional: enables real web-search for founders/professionals (Tavily, 1000 free searches/month)
# Free API key at https://tavily.com
TAVILY_API_KEY=

# Optional: enables sending outreach emails via any SMTP account
# (free options: Gmail app password, Resend SMTP free tier, your domain's mail)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
FROM_EMAIL=
FROM_NAME=Outrovo

# Optional: public URL of this app, used for email open-tracking pixels.
# On Render this is auto-detected via RENDER_EXTERNAL_URL — only set it elsewhere.
PUBLIC_BASE_URL=

# --- Auth & billing (commercial mode) ---
# AUTH_REQUIRED=1          # force login before searching (default: open demo mode)
AUTH_REQUIRED=
# Stripe: Pro plan checkout + webhook → /api/billing/webhook
STRIPE_SECRET_KEY=
STRIPE_PRICE_ID=           # recurring price, e.g. price_123
STRIPE_WEBHOOK_SECRET=     # whsec_... from the Stripe dashboard webhook
